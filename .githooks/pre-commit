#!/usr/bin/env bash
# Formats the staged Go files with gofmt before the commit is created.
# Install with: make hooks
set -euo pipefail

mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.go')
[ "${#staged[@]}" -eq 0 ] && exit 0

for file in "${staged[@]}"; do
	if ! git diff --quiet -- "$file"; then
		echo "pre-commit: $file has unstaged changes, stage or stash them first so gofmt does not stage them by accident" >&2
		exit 1
	fi
done

unformatted=$(gofmt -l "${staged[@]}")
[ -z "$unformatted" ] && exit 0

echo "pre-commit: formatting with gofmt:" >&2
echo "$unformatted" | sed 's/^/  /' >&2
gofmt -w $unformatted
git add -- $unformatted
